+/* ---------- split-flap board ---------- */
+
+const GLYPHS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789'
+
+function Flap({ char, delay, active, dim }: { char: string; delay: number; active: boolean; dim: boolean }) {
+  const reduce = useReducedMotion()
+  const [shown, setShown] = useState(' ')
+
+  useEffect(() => {
+    if (reduce) {
+      setShown(char)
+      return
+    }
+    if (!active) return
+    let tick: ReturnType<typeof setInterval> | undefined
+    const start = setTimeout(() => {
+      let n = 0
+      tick = setInterval(() => {
+        n += 1
+        if (n > 7) {
+          setShown(char)
+          if (tick) clearInterval(tick)
+        } else {
+          setShown(GLYPHS[Math.floor(Math.random() * GLYPHS.length)])
+        }
+      }, 60)
+    }, delay)
+    return () => {
+      clearTimeout(start)
+      if (tick) clearInterval(tick)
+    }
+  }, [active, char, delay, reduce])
+
+  return (
+    <span
+      className={`relative flex h-11 w-7 items-center justify-center rounded bg-dusk-console font-mono text-2xl uppercase sm:h-[72px] sm:w-11 sm:text-[40px] ${
+        dim ? 'text-dusk-track' : 'text-dusk-white'
+      }`}
+    >
+      <span aria-hidden="true" className="absolute inset-x-0 top-1/2 h-px bg-white/[0.09]" />
+      {shown === ' ' ? '\u00a0' : shown}
+    </span>
   )
 }
 
